# Sao chép file này thành .env rồi sửa giá trị. KHÔNG commit .env (đã có trong .gitignore).
# Mọi giá trị dưới đây chỉ là giá trị mẫu cho môi trường phát triển, không phải giá trị thật.
# Danh sách biến phải khớp backend/app/core/config.py.

# --- Chung ---
# development | production (production tắt Swagger)
APP_ENV=development

# --- PostgreSQL (container db trong docker-compose.yml) ---
POSTGRES_USER=classroom
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=classroom

# URL kết nối khi chạy back-end NGOÀI Docker (make dev-be, make migrate).
# Phải khớp POSTGRES_* ở trên. Trong Docker, docker-compose.yml tự đổi host thành "db".
# Dùng 127.0.0.1 thay vì localhost: tránh thử IPv6 trước (trên Windows, mỗi địa chỉ lỗi tốn trọn
# thời gian timeout) và khớp với cổng DB chỉ được mở trên 127.0.0.1.
DATABASE_URL=postgresql+psycopg://classroom:doi-mat-khau-nay@127.0.0.1:5432/classroom

# --- Xác thực (Giai đoạn 2) ---
# Chuỗi ngẫu nhiên dài từ 32 ký tự (ngắn hơn thì ứng dụng không khởi động), giữ bí mật.
# Đổi trước khi triển khai thật.
JWT_SECRET=doi-gia-tri-nay-truoc-khi-trien-khai
# Thời hạn đăng nhập tính bằng phút (5 đến 1440). Hết hạn thì đăng nhập lại.
JWT_EXPIRE_MINUTES=120

# --- LLM (Giai đoạn 8) ---
# Nhà cung cấp: "anthropic" (SDK chính thức, cần LLM_API_KEY), "gemini" (SDK google-genai, khoá tạo ở
# Google AI Studio) hoặc "ollama" (chạy nội bộ, cần LLM_MODEL).
# Để trống thì Trợ lý AI báo chưa cấu hình (HTTP 503); các phần khác của hệ thống vẫn chạy.
LLM_PROVIDER=
# Khoá API của nhà cung cấp. Để trống; điền vào .env cục bộ, không bao giờ commit.
LLM_API_KEY=
# anthropic: để trống thì dùng claude-sonnet-5-5. gemini: để trống thì dùng gemini-flash-latest (bí danh
# Flash mới nhất; dòng Pro cần gói trả phí, gói miễn phí chỉ vài yêu cầu mỗi phút).
# ollama: bắt buộc, mô hình 7-8B có gọi hàm (ví dụ qwen2.5:7b).
LLM_MODEL=
# Ollama chạy trên máy host mà back-end chạy trong Docker: http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
# Thời gian chờ tối đa một lần gọi LLM (giây).
LLM_TIMEOUT_SECONDS=60
# Số câu hỏi tối đa mỗi phút cho mỗi tài khoản (trên mức này API trả 429).
ASSISTANT_RATE_PER_MINUTE=10

# --- Nhận xét và báo cáo (Giai đoạn 9) ---
# Tên trường in ở đầu phiếu liên lạc và báo cáo PDF. Để trống thì in "Trường THPT (chưa đặt tên)".
SCHOOL_NAME=

# --- RAG (Giai đoạn 7) ---
# Mô hình embedding (sentence-transformers, chạy CPU). Mặc định bge-m3 (1024 chiều, khoảng 2,3 GB tải
# về lần đầu vào cache HuggingFace). Để trống thì dùng bge-m3. Đổi sang multilingual-e5-large
# ("intfloat/multilingual-e5-large") được vì cùng 1024 chiều; mô hình khác số chiều cần migration mới.
EMBEDDING_MODEL=BAAI/bge-m3
# Số chiều vector của cột regulation_chunks.embedding (1024 = bge-m3, multilingual-e5-large).
# Migration cố định số này vào cột khi chạy; đổi về sau cần migration mới và tính lại vector.
EMBEDDING_DIM=1024

# --- Test có DB thật (tuỳ chọn) ---
# Mặc định test dùng database "classroom_test" cùng máy chủ với DATABASE_URL (tự tạo, tự xoá và dựng
# lại mỗi lần chạy). Chỉ đặt biến này khi cần trỏ tới máy chủ khác (CI đặt sẵn).
# TEST_DATABASE_URL=postgresql+psycopg://classroom:doi-mat-khau-nay@127.0.0.1:5432/classroom_test
